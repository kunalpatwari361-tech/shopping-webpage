# ============================================================
# Pawan Mode server settings
# Copy this file to .env and fill it in. .env stays on the server
# and is never committed or sent to the browser.
# ============================================================

# "production" on the live server. Turns on HTTPS-only headers and
# blocks demo payments.
NODE_ENV=development
PORT=3000
# HOST=127.0.0.1

# If the site runs behind a proxy such as Nginx, Cloudflare or Render,
# set how many proxies sit in front of it (usually 1).
# TRUST_PROXY=1

# ---------- Payments: Razorpay (PhonePe, Google Pay, Paytm and cards) ----------
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_ keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks. Add
#   https://YOUR-DOMAIN/api/webhooks/razorpay
# with the events payment.captured, order.paid and payment.failed,
# and paste the webhook secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# With no Razorpay keys, development uses simulated payments so you can
# test checkout. Set to false to switch that off. Never allowed in production.
# DEMO_PAYMENTS=true

# ---------- Admin panel (/admin.html) ----------
# At least 12 characters. The admin panel stays off until this is set.
ADMIN_PASSWORD=
# ADMIN_SESSION_HOURS=12

# ---------- Racing map downloads ----------
# Upload map files from the admin panel, or put each one in
# private/downloads/<product-id>.zip
# DOWNLOAD_DIR=private/downloads
# DOWNLOAD_DAYS=30
# DOWNLOAD_LIMIT=5
# Largest map file the admin panel accepts, in MB. If Nginx is in front,
# set client_max_body_size to match.
# UPLOAD_MAX_MB=200

# ---------- Visitor counts in the admin panel ----------
# No cookies and no stored IP addresses. Set to false to switch off.
# COUNT_VISITORS=true
# Time zone used for "today" in the admin panel.
# TIME_ZONE=Asia/Kolkata

# ---------- Housekeeping ----------
# Cancel orders that were never paid after this many hours.
# UNPAID_ORDER_HOURS=48
# DB_FILE=data/store.db
# LOG_REQUESTS=true
